{
  "name": "mm-rates-api",
  "version": "1.4.1",
  "description": "Myanmar exchange-rate, gold and crypto PWA with a SQLite-backed API",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/collect.js && node --check src/db.js && node --check public/app.js && node --check public/sw.js",
    "test:unit": "node --test test/*.test.js",
    "audit": "npm audit --omit=dev",
    "backup": "node scripts/backup.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "keywords": [
    "myanmar",
    "exchange-rates",
    "pwa",
    "sqlite"
  ],
  "author": "Min SiThu",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "homepage": "https://minsithu.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsmeminsithu/mm-rates.git"
  },
  "bugs": {
    "url": "mailto:alex@minsithu.org"
  }
}
