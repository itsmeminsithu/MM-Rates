NODE_ENV=development
PORT=3000
DB_PATH=./data/mmrates.db
CRON_SCHEDULE=*/30 * * * *

# Production: use a random value of at least 24 characters.
ADMIN_TOKEN=replace-with-a-long-random-production-token

# Prevent public refresh requests from repeatedly calling upstream services.
PUBLIC_REFRESH_MIN_AGE_MS=600000

# Display/readiness freshness limits.
CORE_STALE_MS=7200000
OPTIONAL_STALE_MS=21600000
OFFICIAL_STALE_MS=259200000
GOLD_STALE_MS=129600000

# Reject entire upstream datasets whose own publication time is too old.
MARKET_SOURCE_MAX_AGE_MS=21600000
CBM_SOURCE_MAX_AGE_MS=259200000
CRYPTO_SOURCE_MAX_AGE_MS=7200000

# Behind Caddy/nginx set this to true (one trusted proxy hop).
TRUST_PROXY=

# Backup retention used by scripts/backup.js.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
